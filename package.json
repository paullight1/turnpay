{
  "name": "trustpay",
  "version": "1.0.0",
  "private": true,
  "description": "TrustPay - Fintech application for currency exchange, VTU, and bill payments",
  "scripts": {
    "dev:backend": "cd backend && npm run start:dev",
    "dev:web": "cd website && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "build:backend": "cd backend && npm run build",
    "build:web": "cd website && npm run build",
    "build": "npm run build:backend && npm run build:web",
    "lint:backend": "cd backend && npm run lint",
    "lint:web": "cd website && npm run lint",
    "lint": "npm run lint:backend && npm run lint:web",
    "test:backend": "cd backend && npm run test",
    "test:backend:cov": "cd backend && npm run test:cov",
    "test:e2e:web": "cd website && npm run test:e2e",
    "test": "npm run test:backend",
    "seed": "cd backend && npm run seed",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:generate": "cd backend && npm run db:generate",
    "db:studio": "cd backend && npm run db:studio",
    "db:deploy": "cd backend && npm run db:deploy",
    "db:reset": "cd backend && npm run db:reset",
    "docker:up": "cd backend && docker-compose up -d",
    "docker:down": "cd backend && docker-compose down",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d --build",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.7"
  }
}
