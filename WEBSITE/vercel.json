{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev --port 3001",
  "installCommand": "npm ci",
  "outputDirectory": ".next",

  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true
    }
  },

  "redirects": [
    {
      "source": "/signup",
      "destination": "/register",
      "permanent": true
    },
    {
      "source": "/signin",
      "destination": "/login",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.trustpayhq.com/api/:path*"
    }
  ]
}
