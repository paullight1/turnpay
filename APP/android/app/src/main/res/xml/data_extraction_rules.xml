<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep device-bound secure storage out of both restore paths. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml.bak" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml.bak" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml.bak" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml.bak" />
    </device-transfer>
</data-extraction-rules>
