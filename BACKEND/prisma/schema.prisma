generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum KYCStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum KYCType {
  BVN
  NIN
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
  ESCALATED
}

enum TransactionType {
  EXCHANGE
  FUND
  WITHDRAW
  AIRTIME
  DATA
  CABLE
  ELECTRICITY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum WalletCurrency {
  NGN
  GHS
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  phone               String          @unique
  password            String
  role                UserRole        @default(USER)
  kycStatus           KYCStatus       @default(PENDING)
  dailyWithdrawLimit  Decimal         @default(500000) @db.Decimal(15, 2)
  monthlyWithdrawLimit Decimal        @default(5000000) @db.Decimal(15, 2)
  dailyWithdrawn      Decimal         @default(0) @db.Decimal(15, 2)
  monthlyWithdrawn    Decimal         @default(0) @db.Decimal(15, 2)
  limitResetDate      DateTime?
  isSuspended         Boolean         @default(false)
  failedAttempts      Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  wallets             Wallet[]
  transactions        Transaction[]
  refreshTokens       RefreshToken[]
  kycDocuments        KycDocument[]
  disputes            Dispute[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Wallet {
  id        String        @id @default(uuid())
  userId    String
  currency  WalletCurrency
  balance   Decimal       @default(0) @db.Decimal(15, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, currency])
  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  walletId    String?
  type        TransactionType
  amount      Decimal           @db.Decimal(15, 2)
  currency    WalletCurrency
  status      TransactionStatus @default(PENDING)
  reference   String            @unique
  fee         Decimal           @default(0) @db.Decimal(15, 2)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  wallet  Wallet?  @relation(fields: [walletId], references: [id])
  disputes Dispute[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, status])
  @@map("transactions")
}

model Rate {
  id         String   @id @default(uuid())
  from       String
  to         String
  rate       Decimal  @db.Decimal(10, 4)
  markup     Decimal  @default(0) @db.Decimal(5, 2)
  source     String   @default("system")
  validUntil DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([from, to])
  @@map("rates")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  type        String
  provider    String
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model KycDocument {
  id           String   @id @default(uuid())
  userId       String
  type         KYCType
  documentUrl  String
  idNumber     String
  status       KYCStatus @default(PENDING)
  rejectionNote String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("kyc_documents")
}

model Dispute {
  id            String        @id @default(uuid())
  userId        String
  transactionId String?
  type          String
  description   String
  status        DisputeStatus @default(OPEN)
  resolution    String?
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId, status])
  @@index([transactionId])
  @@map("disputes")
}

model WebhookLog {
  id           String   @id @default(uuid())
  provider     String
  eventType    String
  reference    String   @unique
  payload      Json
  processed    Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([provider, reference])
  @@index([processed])
  @@map("webhook_logs")
}
