generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum KYCStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum KYCTier {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

enum KYCType {
  BVN
  NIN
  GHANA_CARD
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

enum KycVerificationProvider {
  MANUAL_REVIEW
  NIBSS
  MONNIFY
  SMILE_ID
  YOUVERIFY
  NINJA
}

enum KycVerificationStatus {
  PENDING
  REVIEW_REQUIRED
  VERIFIED
  REJECTED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
  ESCALATED
}

enum TransactionType {
  EXCHANGE
  FUND
  WITHDRAW
  INTERNAL_TRANSFER
  AIRTIME
  DATA
  CABLE
  ELECTRICITY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum ReferralStatus {
  PENDING
  ELIGIBLE
  PAID
  VOIDED
}

enum WalletCurrency {
  NGN
  GHS
}

enum ExchangeReceiptStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  CREDITED
  REJECTED
  NEEDS_MORE_INFO
}

enum ExchangePayoutStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  SENT
  FAILED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MONNIFY
}

enum VirtualAccountStatus {
  PENDING
  ACTIVE
  FAILED
  DISABLED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  BLOCKED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum TransferAttemptStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum InternalTransferAttemptStatus {
  PROCESSING
  SUCCESS
  FAILED
}

enum InternalTransferReversalStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  BLOCKED
}

enum TransferLimitPeriod {
  DAILY
  MONTHLY
}

enum VtuOrderProvider {
  GENERIC
  VTPASS
  RELOADLY
}

enum VtuOrderScope {
  LOCAL
  INTERNATIONAL
}

enum VtuOrderStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
  UNKNOWN
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  phone                   String    @unique
  fullName                String?
  yearOfBirth             Int?
  country                 String?
  profileDetailsUpdatedAt DateTime?
  referralCode            String?   @unique
  referredById            String?
  password                String
  role                    UserRole  @default(USER)
  kycStatus               KYCStatus @default(PENDING)
  kycTier                 KYCTier   @default(TIER_0)
  dailyWithdrawLimit      Decimal   @default(500000) @db.Decimal(15, 2)
  monthlyWithdrawLimit    Decimal   @default(5000000) @db.Decimal(15, 2)
  dailyWithdrawn          Decimal   @default(0) @db.Decimal(15, 2)
  monthlyWithdrawn        Decimal   @default(0) @db.Decimal(15, 2)
  dailyLimitResetDate     DateTime?
  limitResetDate          DateTime?
  isSuspended             Boolean   @default(false)
  failedAttempts          Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  wallets                    Wallet[]
  transactions               Transaction[]
  internalTransferAttempts   InternalTransferAttempt[]
  internalTransferLimitUsage InternalTransferLimitUsage[]
  refreshTokens              RefreshToken[]
  kycDocuments               KycDocument[]
  kycVerifications           KycVerification[]
  disputes                   Dispute[]
  virtualAccounts            VirtualAccount[]
  bankAccounts               BankAccount[]
  auditLogs                  AuditLog[]
  manualExchangeOrders       ManualExchangeOrder[]
  exchangeReceipts           ExchangeReceipt[]
  exchangePayouts            ExchangePayout[]
  rateOverridesRequested     RateOverride[]               @relation("RequestedOverrides")
  rateOverridesApproved      RateOverride[]               @relation("ApprovedOverrides")
  rateAlerts                 RateAlert[]
  referredBy                 User?                        @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers              User[]                       @relation("UserReferrals")
  referralsGiven             ReferralReward[]             @relation("ReferralReferrer")
  referralReward             ReferralReward?              @relation("ReferralReferred")
  transactionPinCredential   TransactionPinCredential?

  @@index([referredById])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model TransactionPinCredential {
  id             String    @id @default(uuid())
  userId         String    @unique
  salt           String
  hash           String
  iterations     Int
  pinLength      Int?
  resetHoldUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resetHoldUntil])
  @@map("transaction_pin_credentials")
}

model ReferralReward {
  id             String         @id @default(uuid())
  referrerId     String
  referredUserId String         @unique
  referralCode   String
  amount         Decimal        @default(100) @db.Decimal(15, 2)
  currency       WalletCurrency @default(NGN)
  status         ReferralStatus @default(PENDING)
  eligibleAt     DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  referrer     User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, status])
  @@index([referralCode])
  @@map("referral_rewards")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  providerSessionId String?
  deviceId          String
  deviceName        String?
  userAgent         String?
  ipAddress         String?
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@index([providerSessionId, revokedAt, expiresAt])
  @@index([deviceId])
  @@map("refresh_tokens")
}

model Wallet {
  id        String         @id @default(uuid())
  userId    String
  currency  WalletCurrency
  balance   Decimal        @default(0) @db.Decimal(15, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  ledgerEntries LedgerEntry[]

  @@unique([userId, currency])
  @@map("wallets")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  walletId        String?
  type            TransactionType
  amount          Decimal           @db.Decimal(15, 2)
  currency        WalletCurrency
  status          TransactionStatus @default(PENDING)
  reference       String            @unique
  fee             Decimal           @default(0) @db.Decimal(15, 2)
  exchangeQuoteId String?           @unique
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user                User                 @relation(fields: [userId], references: [id])
  wallet              Wallet?              @relation(fields: [walletId], references: [id])
  disputes            Dispute[]
  ledgerEntries       LedgerEntry[]
  transferAttempts    TransferAttempt[]
  vtuOrders           VtuOrder[]
  manualExchangeOrder ManualExchangeOrder?
  exchangeReceipt     ExchangeReceipt?
  exchangePayout      ExchangePayout?

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([walletId])
  @@index([type, status])
  @@index([status, createdAt])
  @@map("transactions")
}

model ExchangeReceipt {
  id                   String                @id @default(uuid())
  userId               String
  transactionId        String                @unique
  sourceCurrency       WalletCurrency        @default(NGN)
  targetCurrency       WalletCurrency        @default(GHS)
  amount               Decimal               @db.Decimal(15, 2)
  expectedCreditAmount Decimal               @db.Decimal(15, 2)
  rate                 Decimal               @db.Decimal(18, 6)
  markupPercent        Decimal               @default(0) @db.Decimal(5, 2)
  bankReference        String                @unique
  senderName           String
  senderBankName       String?
  receiptUrl           String
  status               ExchangeReceiptStatus @default(SUBMITTED)
  adminId              String?
  reviewReason         String?
  creditedAt           DateTime?
  reviewedAt           DateTime?
  metadata             Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("exchange_receipts")
}

model ExchangePayout {
  id                       String               @id @default(uuid())
  userId                   String
  transactionId            String               @unique
  sourceCurrency           WalletCurrency       @default(NGN)
  destinationCurrency      WalletCurrency       @default(GHS)
  sourceAmount             Decimal              @db.Decimal(15, 2)
  destinationAmount        Decimal              @db.Decimal(15, 2)
  rate                     Decimal              @db.Decimal(18, 6)
  fee                      Decimal              @default(0) @db.Decimal(15, 2)
  destinationBankName      String
  destinationBankCode      String?
  destinationAccountNumber String
  destinationAccountName   String
  status                   ExchangePayoutStatus @default(PENDING_APPROVAL)
  adminId                  String?
  adminNote                String?
  adminPaymentReceipt      String?
  notificationSent         Boolean              @default(false)
  reviewedAt               DateTime?
  sentAt                   DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("exchange_payouts")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String
  walletId      String
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(15, 2)
  currency      WalletCurrency
  balanceBefore Decimal         @db.Decimal(15, 2)
  balanceAfter  Decimal         @db.Decimal(15, 2)
  reference     String
  source        String
  metadata      Json?
  createdAt     DateTime        @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  wallet      Wallet      @relation(fields: [walletId], references: [id])

  @@unique([transactionId, source])
  @@index([walletId, createdAt(sort: Desc)])
  @@index([transactionId])
  @@index([reference])
  @@map("ledger_entries")
}

model InternalTransferAttempt {
  id                        String                        @id @default(uuid())
  userId                    String
  recipientUserId           String?
  transferReference         String?
  senderTransactionId       String?
  recipientTransactionId    String?
  status                    InternalTransferAttemptStatus
  amount                    Decimal?                      @db.Decimal(15, 2)
  currency                  WalletCurrency?
  recipientIdentifierType   String?
  recipientMaskedIdentifier String?
  failureCode               String?
  failureMessage            String?
  idempotencyKeyHash        String?                       @db.VarChar(64)
  requestHash               String?                       @db.VarChar(64)
  response                  Json?
  requestId                 String?                       @db.VarChar(128)
  ipAddress                 String?                       @db.VarChar(64)
  userAgent                 String?                       @db.VarChar(256)
  metadata                  Json?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  user     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reversal InternalTransferReversal?

  @@unique([userId, idempotencyKeyHash], map: "internal_transfer_attempts_user_idempotency_key")
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([transferReference])
  @@index([requestId])
  @@map("internal_transfer_attempts")
}

model InternalTransferReversal {
  id                             String                         @id @default(uuid())
  originalAttemptId              String                         @unique
  originalTransferReference      String
  originalSenderTransactionId    String
  originalRecipientTransactionId String
  reversalReference              String?                        @unique
  reversalSenderTransactionId    String?
  reversalRecipientTransactionId String?
  status                         InternalTransferReversalStatus @default(PENDING_APPROVAL)
  amount                         Decimal                        @db.Decimal(15, 2)
  currency                       WalletCurrency
  senderUserId                   String
  recipientUserId                String
  requesterAdminId               String
  approverAdminId                String?
  reviewerAdminId                String?
  requestReason                  String
  reviewReason                   String?
  idempotencyKeyHash             String                         @db.VarChar(64)
  requestHash                    String                         @db.VarChar(64)
  requestId                      String?                        @db.VarChar(128)
  ipAddress                      String?                        @db.VarChar(64)
  userAgent                      String?                        @db.VarChar(256)
  requestedAt                    DateTime                       @default(now())
  approvedAt                     DateTime?
  rejectedAt                     DateTime?
  blockedAt                      DateTime?
  completedAt                    DateTime?
  updatedAt                      DateTime                       @updatedAt

  originalAttempt InternalTransferAttempt @relation(fields: [originalAttemptId], references: [id], onDelete: Restrict)

  @@unique([requesterAdminId, idempotencyKeyHash])
  @@index([status, requestedAt])
  @@index([originalTransferReference])
  @@index([requestId])
  @@map("internal_transfer_reversals")
}

model InternalTransferLimitUsage {
  id          String              @id @default(uuid())
  userId      String
  currency    WalletCurrency
  period      TransferLimitPeriod
  periodStart DateTime
  amount      Decimal             @default(0) @db.Decimal(15, 2)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency, period, periodStart], map: "internal_transfer_limit_usage_userId_currency_period_periodStar")
  @@index([userId, currency, period])
  @@index([periodStart])
  @@map("internal_transfer_limit_usage")
}

model InternalTransferLimitPolicy {
  id             String         @id @default(uuid())
  currency       WalletCurrency
  kycTier        KYCTier
  perTransaction Decimal        @db.Decimal(15, 2)
  daily          Decimal        @db.Decimal(15, 2)
  monthly        Decimal        @db.Decimal(15, 2)
  enabled        Boolean        @default(false)
  version        Int
  requestedById  String?
  approvedById   String?
  reason         String
  approvalReason String?
  approvedAt     DateTime?
  effectiveFrom  DateTime       @default(now())
  disabledAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([currency, kycTier, version])
  @@index([currency, kycTier, enabled, effectiveFrom])
  @@index([requestedById, createdAt])
  @@index([approvedById, approvedAt])
  @@map("internal_transfer_limit_policies")
}

model IdempotencyRecord {
  id                 String   @id @default(uuid())
  scope              String
  key                String
  method             String
  path               String
  requestHash        String
  status             String   @default("IN_PROGRESS")
  response           Json?
  responseCiphertext String?
  responseIv         String?  @db.VarChar(32)
  responseTag        String?  @db.VarChar(32)
  encryptionKeyId    String?  @db.VarChar(64)
  httpStatus         Int?
  errorResponse      Json?
  errorMessage       String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model VirtualAccount {
  id                  String               @id @default(uuid())
  userId              String
  provider            PaymentProvider
  providerAccountId   String?
  providerCustomerId  String?
  accountNumber       String
  accountNumberMasked String
  accountName         String
  bankName            String
  bankCode            String?
  currency            WalletCurrency
  status              VirtualAccountStatus @default(PENDING)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, currency])
  @@unique([provider, accountNumber])
  @@index([userId, status])
  @@index([provider, status])
  @@index([createdAt(sort: Desc)])
  @@map("virtual_accounts")
}

model BankAccount {
  id                     String           @id @default(uuid())
  userId                 String
  provider               PaymentProvider?
  bankCode               String
  bankName               String
  accountName            String
  accountNumberEncrypted String
  accountNumberMasked    String
  currency               WalletCurrency
  isDeleted              Boolean          @default(false)
  metadata               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDeleted])
  @@index([bankCode])
  @@map("bank_accounts")
}

model ProviderEvent {
  id                String              @id @default(uuid())
  provider          PaymentProvider
  eventType         String
  providerReference String
  status            ProviderEventStatus @default(RECEIVED)
  payload           Json
  payloadHash       String?
  errorMessage      String?
  processedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([provider, providerReference, eventType])
  @@index([provider, status])
  @@index([createdAt])
  @@map("provider_events")
}

model PaymentWebhookInbox {
  id                String              @id @default(uuid())
  provider          PaymentProvider
  eventType         String
  providerReference String
  payload           Json
  payloadHash       String
  status            ProviderEventStatus @default(RECEIVED)
  attemptCount      Int                 @default(0)
  nextAttemptAt     DateTime?           @default(now())
  lastError         String?
  receivedAt        DateTime            @default(now())
  claimedAt         DateTime?
  processedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Providers can legitimately send the same event type/reference again with
  // a changed terminal status. Only an exact payload replay is a duplicate.
  @@unique([provider, eventType, providerReference, payloadHash], map: "payment_webhook_inbox_provider_event_reference_payload_key")
  @@index([provider, providerReference], map: "payment_webhook_inbox_provider_reference_idx")
  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
  @@map("payment_webhook_inbox")
}

model ReconciliationRun {
  id              String                  @id @default(uuid())
  scope           String
  status          ReconciliationRunStatus @default(RUNNING)
  initiatedById   String?
  startedAt       DateTime                @default(now())
  completedAt     DateTime?
  checkedCount    Int                     @default(0)
  mismatchCount   Int                     @default(0)
  mismatchDetails Json?
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([scope, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("reconciliation_runs")
}

model TransferAttempt {
  id                String                @id @default(uuid())
  transactionId     String
  provider          PaymentProvider
  providerReference String
  providerStatus    String
  status            TransferAttemptStatus @default(PENDING)
  attemptNo         Int                   @default(1)
  lastCheckedAt     DateTime?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([provider, providerReference])
  @@index([transactionId])
  @@index([status])
  @@map("transfer_attempts")
}

model VtuOrder {
  id                     String           @id @default(uuid())
  transactionId          String           @unique
  provider               VtuOrderProvider
  scope                  VtuOrderScope
  serviceType            TransactionType
  countryCode            String?
  localProvider          String?
  operatorId             String?
  providerRequestId      String
  providerTransactionId  String?
  providerStatus         String?
  status                 VtuOrderStatus   @default(PENDING)
  amount                 Decimal          @db.Decimal(15, 2)
  currency               WalletCurrency
  targetMasked           String?
  costAmount             Decimal?         @db.Decimal(15, 2)
  providerCommission     Decimal?         @db.Decimal(15, 2)
  fee                    Decimal?         @db.Decimal(15, 2)
  margin                 Decimal?         @db.Decimal(15, 2)
  purchasedCodeEncrypted String?          @db.Text
  rawResponse            Json?
  metadata               Json?
  requeryAttempts        Int              @default(0)
  lastRequeryAt          DateTime?
  nextRequeryAt          DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([provider, providerRequestId])
  @@index([provider, status])
  @@index([status, nextRequeryAt])
  @@index([countryCode, serviceType])
  @@index([status, createdAt])
  @@map("vtu_orders")
}

model VtuWebhookInbox {
  id                    String    @id @default(uuid())
  eventKey              String    @unique
  eventType             String
  providerRequestId     String
  providerTransactionId String?
  providerStatus        String
  payloadHash           String
  payload               Json
  attempts              Int       @default(0)
  nextAttemptAt         DateTime  @default(now())
  processedAt           DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([processedAt, nextAttemptAt])
  @@index([providerRequestId])
  @@map("vtu_webhook_inbox")
}

model VtuPricingRule {
  id            String           @id @default(uuid())
  countryCode   String?
  serviceType   TransactionType?
  provider      String?
  scope         VtuOrderScope?
  fixedMargin   Decimal          @default(0) @db.Decimal(15, 2)
  percentMargin Decimal          @default(0) @db.Decimal(7, 4)
  minAmount     Decimal?         @db.Decimal(15, 2)
  maxAmount     Decimal?         @db.Decimal(15, 2)
  priority      Int              @default(0)
  isActive      Boolean          @default(true)
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isActive, priority], map: "vtu_pricing_rules_active_priority_idx")
  @@index([countryCode, serviceType, provider, scope, isActive], map: "vtu_pricing_rules_match_idx")
  @@index([serviceType, scope, isActive], map: "vtu_pricing_rules_service_scope_idx")
  @@map("vtu_pricing_rules")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String
  targetType String
  targetId   String
  reference  String?
  reason     String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([reference])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Rate {
  id         String    @id @default(uuid())
  from       String
  to         String
  rate       Decimal   @db.Decimal(10, 4)
  markup     Decimal   @default(0) @db.Decimal(5, 2)
  source     String    @default("system")
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@unique([from, to])
  @@map("rates")
}

enum RateOverrideStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model RateOverride {
  id               String             @id @default(uuid())
  requestedById    String
  fromCurrency     String
  toCurrency       String
  proposedRate     Decimal            @db.Decimal(10, 4)
  proposedMarkup   Decimal            @db.Decimal(5, 2)
  currentRate      Decimal            @db.Decimal(10, 4)
  deviationPercent Decimal            @db.Decimal(6, 2)
  reason           String
  status           RateOverrideStatus @default(PENDING_APPROVAL)
  approvedById     String?
  reviewReason     String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  requestedBy User  @relation("RequestedOverrides", fields: [requestedById], references: [id])
  approvedBy  User? @relation("ApprovedOverrides", fields: [approvedById], references: [id])

  @@index([status, createdAt])
  @@map("rate_overrides")
}

model RateAlert {
  id           String    @id @default(uuid())
  userId       String
  fromCurrency String
  toCurrency   String
  targetRate   Decimal   @db.Decimal(10, 4)
  direction    String    @default("ABOVE")
  isActive     Boolean   @default(true)
  triggeredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([isActive])
  @@map("rate_alerts")
}

model Service {
  id        String   @id @default(uuid())
  name      String
  type      String
  provider  String
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model KycDocument {
  id            String    @id @default(uuid())
  userId        String
  type          KYCType
  documentUrl   String?
  idNumber      String?
  status        KYCStatus @default(PENDING)
  rejectionNote String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications KycVerification[]

  @@index([userId, status])
  @@map("kyc_documents")
}

model KycVerification {
  id                String                  @id @default(uuid())
  userId            String
  documentId        String
  provider          KycVerificationProvider
  status            KycVerificationStatus   @default(PENDING)
  reference         String
  checks            Json?
  responseHash      String?
  errorMessage      String?
  consentRecordedAt DateTime?
  consentVersion    String?                 @db.VarChar(64)
  consentSource     String?                 @db.VarChar(32)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document KycDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([provider, reference])
  @@index([userId, status])
  @@index([documentId])
  @@index([provider, status])
  @@map("kyc_verifications")
}

model KycWebhookInbox {
  id                String                  @id @default(uuid())
  provider          KycVerificationProvider
  eventType         String
  providerReference String
  payload           Json
  payloadHash       String
  status            ProviderEventStatus     @default(RECEIVED)
  attemptCount      Int                     @default(0)
  nextAttemptAt     DateTime?               @default(now())
  lastError         String?
  receivedAt        DateTime                @default(now())
  claimedAt         DateTime?
  processedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([provider, providerReference, eventType, payloadHash], map: "kyc_webhook_inbox_replay_key")
  @@index([status, nextAttemptAt])
  @@index([providerReference])
  @@map("kyc_webhook_inbox")
}

model Dispute {
  id            String        @id @default(uuid())
  userId        String
  transactionId String?
  type          String
  description   String
  status        DisputeStatus @default(OPEN)
  resolution    String?
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId, status])
  @@index([transactionId])
  @@map("disputes")
}

model WebhookLog {
  id           String   @id @default(uuid())
  provider     String
  eventType    String
  reference    String   @unique
  payload      Json
  processed    Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([provider, reference])
  @@index([processed])
  @@map("webhook_logs")
}

// External-deposit exchange orders are independent of wallet-funded payouts.
enum ManualExchangeSettlement {
  WALLET
  BANK
  MOMO
}

enum ManualExchangeStatus {
  AWAITING_TRANSFER
  AWAITING_CONFIRMATION
  NEEDS_MORE_INFO
  REJECTED
  CREDITED
  PAYOUT_PENDING
  PAYOUT_PROCESSING
  PAYOUT_SENT
  COMPLETED
}

model ManualExchangeOrder {
  id                     String                   @id @default(uuid())
  userId                 String
  transactionId          String                   @unique
  reference              String                   @unique
  createKeyHash          String
  createRequestHash      String
  settlementMode         ManualExchangeSettlement
  status                 ManualExchangeStatus     @default(AWAITING_TRANSFER)
  version                Int                      @default(0)
  sourceCurrency         WalletCurrency           @default(NGN)
  targetCurrency         WalletCurrency           @default(GHS)
  amount                 Decimal                  @db.Decimal(15, 2)
  targetAmount           Decimal                  @db.Decimal(15, 2)
  rate                   Decimal                  @db.Decimal(18, 6)
  fee                    Decimal                  @default(0) @db.Decimal(15, 2)
  collectionAccount      Json
  destinationInstitution String?
  destinationAccount     String?
  destinationName        String?
  proofKey               String?
  bankReference          String?
  depositReference       String?                  @unique
  payoutReference        String?                  @unique
  payoutProofKey         String?
  payoutClaimedBy        String?
  reviewReason           String?
  expiresAt              DateTime
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  user                   User                     @relation(fields: [userId], references: [id])
  transaction            Transaction              @relation(fields: [transactionId], references: [id])
  events                 ManualExchangeEvent[]
  proofs                 ManualExchangeProof[]

  @@unique([userId, createKeyHash])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("manual_exchange_orders")
}

model ManualExchangeEvent {
  id          String               @id @default(uuid())
  orderId     String
  actorId     String
  action      String
  keyHash     String
  requestHash String
  status      ManualExchangeStatus
  reason      String
  createdAt   DateTime             @default(now())
  order       ManualExchangeOrder  @relation(fields: [orderId], references: [id])

  @@unique([orderId, actorId, action, keyHash])
  @@index([orderId, createdAt])
  @@map("manual_exchange_events")
}

model ManualExchangeProof {
  id                String              @id @default(uuid())
  orderId           String
  actorId           String
  kind              String
  objectKey         String              @unique
  contentType       String
  fileSize          Int
  uploadKeyHash     String?
  uploadRequestHash String?
  createdAt         DateTime            @default(now())
  order             ManualExchangeOrder @relation(fields: [orderId], references: [id])

  @@unique([orderId, actorId, kind, uploadKeyHash])
  @@index([orderId, kind])
  @@map("manual_exchange_proofs")
}

// Shared by manual exchange variants, so a verified bank deposit settles once.
model ExchangeDepositAllocation {
  reference    String   @id
  settlementId String   @unique
  amount       Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())

  @@map("exchange_deposit_allocations")
}
