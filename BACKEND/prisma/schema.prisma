generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum KYCStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum KYCType {
  BVN
  NIN
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
  ESCALATED
}

enum TransactionType {
  EXCHANGE
  FUND
  WITHDRAW
  INTERNAL_TRANSFER
  AIRTIME
  DATA
  CABLE
  ELECTRICITY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum WalletCurrency {
  NGN
  GHS
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
}

enum VirtualAccountStatus {
  PENDING
  ACTIVE
  FAILED
  DISABLED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum TransferAttemptStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  phone               String          @unique
  fullName            String?
  password            String
  role                UserRole        @default(USER)
  kycStatus           KYCStatus       @default(PENDING)
  dailyWithdrawLimit  Decimal         @default(500000) @db.Decimal(15, 2)
  monthlyWithdrawLimit Decimal        @default(5000000) @db.Decimal(15, 2)
  dailyWithdrawn      Decimal         @default(0) @db.Decimal(15, 2)
  monthlyWithdrawn    Decimal         @default(0) @db.Decimal(15, 2)
  limitResetDate      DateTime?
  isSuspended         Boolean         @default(false)
  failedAttempts      Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  wallets             Wallet[]
  transactions        Transaction[]
  refreshTokens       RefreshToken[]
  kycDocuments        KycDocument[]
  disputes            Dispute[]
  virtualAccounts     VirtualAccount[]
  bankAccounts        BankAccount[]
  auditLogs           AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Wallet {
  id        String        @id @default(uuid())
  userId    String
  currency  WalletCurrency
  balance   Decimal       @default(0) @db.Decimal(15, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  ledgerEntries LedgerEntry[]

  @@unique([userId, currency])
  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  walletId    String?
  type        TransactionType
  amount      Decimal           @db.Decimal(15, 2)
  currency    WalletCurrency
  status      TransactionStatus @default(PENDING)
  reference   String            @unique
  fee         Decimal           @default(0) @db.Decimal(15, 2)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  wallet  Wallet?  @relation(fields: [walletId], references: [id])
  disputes Dispute[]
  ledgerEntries LedgerEntry[]
  transferAttempts TransferAttempt[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, status])
  @@map("transactions")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String
  walletId      String
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(15, 2)
  currency      WalletCurrency
  balanceBefore Decimal         @db.Decimal(15, 2)
  balanceAfter  Decimal         @db.Decimal(15, 2)
  reference     String
  source        String
  metadata      Json?
  createdAt     DateTime        @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  wallet      Wallet      @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@index([transactionId])
  @@index([reference])
  @@unique([transactionId, source])
  @@map("ledger_entries")
}

model IdempotencyRecord {
  id          String   @id @default(uuid())
  scope       String
  key         String
  method      String
  path        String
  requestHash String
  status      String   @default("IN_PROGRESS")
  response    Json?
  errorMessage String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model VirtualAccount {
  id                  String               @id @default(uuid())
  userId              String
  provider            PaymentProvider
  providerAccountId   String?
  providerCustomerId  String?
  accountNumber       String
  accountNumberMasked String
  accountName         String
  bankName            String
  bankCode            String?
  currency            WalletCurrency
  status              VirtualAccountStatus @default(PENDING)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, currency])
  @@unique([provider, accountNumber])
  @@index([userId, status])
  @@index([provider, status])
  @@map("virtual_accounts")
}

model BankAccount {
  id                     String          @id @default(uuid())
  userId                 String
  provider               PaymentProvider?
  bankCode               String
  bankName               String
  accountName            String
  accountNumberEncrypted String
  accountNumberMasked    String
  currency               WalletCurrency
  isDeleted              Boolean         @default(false)
  metadata               Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDeleted])
  @@index([bankCode])
  @@map("bank_accounts")
}

model ProviderEvent {
  id                String              @id @default(uuid())
  provider          PaymentProvider
  eventType         String
  providerReference String
  status            ProviderEventStatus @default(RECEIVED)
  payload           Json
  payloadHash       String?
  errorMessage      String?
  processedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([provider, providerReference, eventType])
  @@index([provider, status])
  @@index([createdAt])
  @@map("provider_events")
}

model TransferAttempt {
  id                String                @id @default(uuid())
  transactionId     String
  provider          PaymentProvider
  providerReference String
  providerStatus    String
  status            TransferAttemptStatus @default(PENDING)
  attemptNo         Int                   @default(1)
  lastCheckedAt     DateTime?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([provider, providerReference])
  @@index([transactionId])
  @@index([status])
  @@map("transfer_attempts")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String
  targetType String
  targetId   String
  reference  String?
  reason     String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([reference])
  @@map("audit_logs")
}

model Rate {
  id         String   @id @default(uuid())
  from       String
  to         String
  rate       Decimal  @db.Decimal(10, 4)
  markup     Decimal  @default(0) @db.Decimal(5, 2)
  source     String   @default("system")
  validUntil DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([from, to])
  @@map("rates")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  type        String
  provider    String
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model KycDocument {
  id           String   @id @default(uuid())
  userId       String
  type         KYCType
  documentUrl  String
  idNumber     String
  status       KYCStatus @default(PENDING)
  rejectionNote String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("kyc_documents")
}

model Dispute {
  id            String        @id @default(uuid())
  userId        String
  transactionId String?
  type          String
  description   String
  status        DisputeStatus @default(OPEN)
  resolution    String?
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId, status])
  @@index([transactionId])
  @@map("disputes")
}

model WebhookLog {
  id           String   @id @default(uuid())
  provider     String
  eventType    String
  reference    String   @unique
  payload      Json
  processed    Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([provider, reference])
  @@index([processed])
  @@map("webhook_logs")
}
