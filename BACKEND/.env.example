# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://trustpay:trustpay_secret@localhost:5432/trustpay_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_IN=5m
OTP_LENGTH=6

# SMS Provider (Twilio / Africa's Talking)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment Gateways
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_HASH=

# VTU API (Reloadly / Shago / TopUp)
VTU_API_URL=
VTU_API_KEY=

# FX Rate API
FX_RATE_API_URL=
FX_RATE_API_KEY=

# Logging
LOG_LEVEL=debug
