# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://trustpay:trustpay_secret@localhost:5432/trustpay_db?schema=public

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_ANON_KEY=your_legacy_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP
OTP_EXPIRES_IN=5m
OTP_LENGTH=6
OTP_DEV_CODE=

# SMS Provider (Twilio / Africa's Talking)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Provider (Resend / SendGrid)
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Payment Gateways
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_URL=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_DVA_PREFERRED_BANK=test-bank
PAYSTACK_TRANSFER_SOURCE=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_WEBHOOK_URL=

# Banking Feature Flags
BANKING_ENABLED=false
VIRTUAL_ACCOUNTS_ENABLED=false
WITHDRAWALS_ENABLED=false
BANKING_PROVIDER_PRIMARY=paystack
BANKING_PROVIDER_FALLBACK=flutterwave
SUPPORTED_BANKING_CURRENCIES=NGN
BANKING_SANDBOX_MODE=true

# Privacy / Sensitive Data
PII_ENCRYPTION_KEY=
PII_KEY_VERSION=1
BANK_ACCOUNT_ENCRYPTION_KEY=

# Banking Jobs / Queues
RECONCILIATION_CRON=0 */1 * * *
WEBHOOK_QUEUE_NAME=banking-webhooks
DLQ_NAME=banking-dead-letter
ADMIN_REVIEW_WEBHOOK_ALERT_CHANNEL=

# VTU API (Reloadly / Shago / TopUp)
VTU_API_URL=
VTU_API_KEY=

# FX Rate API
FX_RATE_API_URL=
FX_RATE_API_KEY=

# URLs
WEB_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Logging
LOG_LEVEL=debug

# Error Tracking
SENTRY_DSN=
