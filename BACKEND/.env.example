# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://trustpay:trustpay_secret@localhost:5432/trustpay_db?schema=public

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP
OTP_EXPIRES_IN=5m
OTP_LENGTH=6

# SMS Provider (Twilio / Africa's Talking)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Provider (Resend / SendGrid)
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Payment Gateways
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_HASH=

# VTU API (Reloadly / Shago / TopUp)
VTU_API_URL=
VTU_API_KEY=

# FX Rate API
FX_RATE_API_URL=
FX_RATE_API_KEY=

# URLs
WEB_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Logging
LOG_LEVEL=debug

# Error Tracking
SENTRY_DSN=
