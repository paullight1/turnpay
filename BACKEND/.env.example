# =============================================================================
# TRUSTPAY — Backend Environment Variables Template
# =============================================================================
# Copy to .env and fill in values.
#
# LEGEND:
#   ✅ REQUIRED      — App will not start without this
#   🔒 SENSITIVE     — Must use secret manager, never commit to git
#   📋 CONFIG        — Non-sensitive, safe in env files
#   🚨 PRODUCTION    — Must use unique, cryptographically random values in prod
#   🧪 DEVELOPMENT   — Safe defaults for local dev / Docker Compose
# =============================================================================

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development          # 📋 production | development | staging
PORT=3001                     # 📋 Local backend listen port; production may override this
LOG_LEVEL=debug               # 📋 debug locally, info on Render/staging/prod

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# ✅🔒🚨 Full connection string. Use pgBouncer port (25060) for managed DO Postgres.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require&schema=public
DATABASE_URL=postgresql://trustpay:trustpay_secret@localhost:5432/trustpay_db?schema=public

# ─── PostgreSQL (Docker-only, not needed with managed DO Postgres) ──────────
# 📋 Only used by docker-compose.yml for local dev
POSTGRES_USER=trustpay
POSTGRES_PASSWORD=trustpay_secret
POSTGRES_DB=trustpay_db

# ─── Redis ──────────────────────────────────────────────────────────────────
# ✅🔒🚨 Managed Redis connection
# DO Managed Redis: port 25061 (TLS), host = trustpay-redis-do-user-XXXX-0.db.ondigitalocean.com
# Full connection string (recommended for Render Key Value / managed Redis):
REDIS_URL=                    # ✅🔒🚨 e.g. redis://red-xxxxx:6379 or rediss://default:TOKEN@HOST:25061
# Host/port/password are kept for local Docker or providers that do not give a URL:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Per-process memory mode is local-only and must be explicitly enabled.
REDIS_ALLOW_MEMORY_FALLBACK=false
# Local direct connections trust no proxy. Deployed platforms must set 1 or 2.
TRUST_PROXY_HOPS=0

# ─── Supabase (Authentication & Storage) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co                   # ✅ Supabase project URL
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here           # ✅ Anon/publishable key
SUPABASE_ANON_KEY=sb_anon_your_key_here                         # ✅ Anon key (fallback)
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_your_key_here         # ✅🔒🚨 Service role (admin privileges)
SUPABASE_JWT_SECRET=                                            # 🔒 Supabase JWT signing secret

# ─── JWT Tokens ─────────────────────────────────────────────────────────────
# 🚨 Generate with: openssl rand -base64 32
JWT_SECRET=dev_jwt_secret_do_not_use                            # ✅🔒🚨 Access token signing (15min TTL)
JWT_REFRESH_SECRET=dev_refresh_secret_do_not_use                # ✅🔒🚨 Refresh token signing (7d TTL)

# ─── Web URLs ───────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000                                   # ✅🚨 Production frontend URL (e.g. https://trustpay.vercel.app)
ADMIN_URL=http://localhost:3000/admin                           # ✅🚨 Production admin URL
# NEXT_PUBLIC_API_URL (set on WEBSITE, not backend)

# ─── Encryption Keys ────────────────────────────────────────────────────────
# 🚨 Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY=replace-with-32-plus-character-key            # ✅🔒🚨 256-bit AES for PII (phone, email, BVN, NIN)
BANK_ACCOUNT_ENCRYPTION_KEY=test-bank-account-encryption-key    # ✅🔒🚨 256-bit AES for bank account numbers

# ─── Banking / Virtual Accounts ─────────────────────────────────────────────
BANKING_ENABLED=true                                            # 📋 Feature flag: enable banking module
VIRTUAL_ACCOUNTS_ENABLED=true                                   # 📋 Feature flag: enable virtual account provisioning
BANKING_SANDBOX_MODE=true                                       # 📋🚨 true in dev/staging, MUST be false in production
BANKING_PROVIDER_PRIMARY=paystack                                # 📋 Single banking and payments provider
VIRTUAL_ACCOUNT_NAME_PREFIX=TrustPay                            # 📋 Brand prefix on virtual account names ("TrustPay - Jane Doe"); empty disables
SUPPORTED_BANKING_CURRENCIES=NGN                                # 📋 Comma-separated: NGN,GHS

# ─── Monnify (Legacy reconciliation only — optional) ───────────────────────────
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://api.monnify.com
MONNIFY_KYC_SYNC_ENABLED=false
MONNIFY_WEBHOOK_URL=
MONNIFY_EXCHANGE_COLLECTION_ACCOUNT_NUMBER=
# Paystack is the primary provider. The secret stays on the backend.
PAYSTACK_SECRET_KEY=                                             # sk_test_... locally; sk_live_... in production
PAYSTACK_DVA_PREFERRED_BANK=                                     # Optional bank slug; discover available banks automatically
PAYSTACK_CHECKOUT_ENABLED=true
# Set https://YOUR_API_HOST/api/webhooks/paystack in the Paystack dashboard.
# No separate Paystack webhook secret or client public key is required for hosted checkout.
# Manual NGN -> GHS orders. Enable only after staging acceptance.
# Use a dedicated collection account, never a customer's auto-credit virtual account.
MANUAL_EXCHANGE_ENABLED=false
MANUAL_EXCHANGE_COLLECTION_BANK_NAME=
MANUAL_EXCHANGE_COLLECTION_ACCOUNT_NAME=
MANUAL_EXCHANGE_COLLECTION_ACCOUNT_NUMBER=
MANUAL_EXCHANGE_COLLECTION_VERSION=
# Reverse GHS -> NGN collection; configure all four fields to enable this direction.
MANUAL_EXCHANGE_GHS_COLLECTION_BANK_NAME=
MANUAL_EXCHANGE_GHS_COLLECTION_ACCOUNT_NAME=
MANUAL_EXCHANGE_GHS_COLLECTION_ACCOUNT_NUMBER=
MANUAL_EXCHANGE_GHS_COLLECTION_VERSION=
# External FX feed. Without a configured feed, fallback rates are display-only;
# exchange execution requires a fresh, validated provider or admin rate.
FX_API_URL=
FX_API_KEY=
MONNIFY_SANDBOX_TEST_KYC_BYPASS=false                            # 📋 Bypass KYC in sandbox (false in prod)
MONNIFY_TEST_BVN=22222222226                                    # 📋 Sandbox test BVN
MONNIFY_GET_ALL_AVAILABLE_BANKS=true                            # 📋 Fetch full bank list
MONNIFY_RESTRICT_PAYMENT_SOURCE=false                           # 📋 Restrict funding sources

# ─── VTU (Airtime, Data, Cable TV, Electricity) ─────────────────────────────
VTU_PROVIDER=vtpass                                             # 📋 Single VTU provider
VTU_ENABLED=true                                                # 📋 Feature flag: enable VTU module
VTU_SIMULATION_ENABLED=false                                    # 📋 Explicit dev/test-only simulation switch
VTU_KYC_BYPASS=false                                            # 📋 Test-only bypass for VTU KYC gate
VTPASS_BASE_URL=https://sandbox.vtpass.com/api                  # 📋🚨 https://vtpass.com/api in production
VTPASS_API_KEY=your_vtpass_api_key                              # 🔒🚨 VTPass API key
VTPASS_PUBLIC_KEY=PK_your_vtpass_public_key                     # 🔒🚨 VTPass public key
VTPASS_SECRET_KEY=SK_your_vtpass_secret_key                     # 🔒🚨 VTPass secret key
VTPASS_WEBHOOK_SECRET=                                          # 🔒🚨 HMAC secret shared only with the trusted callback gateway
VTPASS_LOW_BALANCE_THRESHOLD=5000                               # 📋 Low balance alert in NGN

# ─── Phone OTP delivery ────────────────────────────────────────────────────
# Required in staging/production. Provision these through the secret manager.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRES_IN=5m
OTP_LENGTH=6
# Optional six-digit override for development/test ONLY; forbidden when deployed.
OTP_DEV_CODE=

# ─── Sentry (Error Tracking) ────────────────────────────────────────────────
SENTRY_DSN=                                                     # 📋🚨 Sentry project DSN for error tracking

# ─── Feature Flags ──────────────────────────────────────────────────────────
TRANSACTION_PIN_REQUIRED=true                                   # 📋🚨 Require PIN for transactions (must be true in prod)
IDEMPOTENCY_RESPONSE_ENCRYPTION_KEY=                            # 🚨 Base64-encoded 32-byte AES key from secrets manager
IDEMPOTENCY_RESPONSE_ENCRYPTION_KEY_ID=v1                       # 📋 Key rotation identifier stored with ciphertext
INTERNAL_TRANSFERS_ENABLED=false                                # 📋🚨 Keep false until transfer production certification passes
ENABLE_SWAGGER=false                                            # 📋🚨 Enable API docs (must be false in prod)
EXCHANGE_REVIEW_REQUIRED=true                                   # 📋 Flag large exchanges for admin review
WITHDRAWALS_ENABLED=true                                        # 📋 Feature flag: withdrawals module

# ─── KYC / Document Storage ─────────────────────────────────────────────────
KYC_DOCUMENT_BUCKET=kyc-documents                               # 📋 Supabase storage bucket name
KYC_ADMIN_DOCUMENT_URL_TTL_SECONDS=300                          # 📋 Signed URL TTL for admin review
PII_KEY_VERSION=1                                               # 📋 Active encryption key version (for rotation)
KYC_PROVIDER=paystack                                           # 📋 Active Nigeria-only KYC provider
# Monnify verifies NIN/BVN directly and returns the verification result.

# ─── Reconciliation ─────────────────────────────────────────────────────────
# RECONCILIATION_CRON=0 */1 * * *                               # 📋 Cron schedule for auto-reconciliation
# WEBHOOK_QUEUE_NAME=banking-webhooks                            # 📋 Redis key for webhook queue
# DLQ_NAME=banking-dead-letter                                   # 📋 Redis key for dead letter queue
# ADMIN_REVIEW_WEBHOOK_ALERT_CHANNEL=                            # 📋 Alert channel for failed webhooks

# ─── Banking Partner Config ──────────────────────────────────────────────────
# Monnify limit-profile codes created in the Monnify dashboard. Tier 1 is the
# limited BVN-or-NIN profile; Tier 2 is the higher-limit BVN-and-NIN profile.
# Production provisioning fails closed when the matching code is absent.
MONNIFY_TIER_1_LIMIT_PROFILE_CODE=                           # 🔒 Monnify limited profile
MONNIFY_TIER_2_LIMIT_PROFILE_CODE=                           # 🔒 Monnify higher-limit profile
# MONNIFY_DAILY_LIMIT_NGN=                                      # 📋 Daily transaction limit
# MONNIFY_MAX_SINGLE_TRANSFER_NGN=                               # 📋 Max single transfer
# BANKING_RETRY_MAX_ATTEMPTS=3                                   # 📋 Webhook retry max
# BANKING_RETRY_BACKOFF_MS=5000                                  # 📋 Webhook retry backoff

# ─── Next.js Frontend (WEBSITE) ─────────────────────────────────────────────
# These are set on the WEBSITE deployment, NOT the backend.
# Listed here for cross-reference only.
# NEXT_PUBLIC_API_URL=https://api.trustpayhq.com                 # ✅🚨 Backend API URL for frontend
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co      # ✅🚨 Supabase URL for frontend
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key   # ✅🚨 Supabase anon key for frontend

# Kora handles Ghana only; product access and exchange approval are separate.
KORA_SECRET_KEY=
KORA_GHS_ENABLED=false
KORA_GHS_VIRTUAL_ACCOUNTS_ENABLED=false
KORA_GHS_MOMO_COLLECTIONS_ENABLED=false
KORA_GHS_MOMO_PAYOUTS_ENABLED=false
KORA_EXCHANGE_USE_CASE_APPROVED=false
PAYSTACK_EXCHANGE_USE_CASE_APPROVED=false
# Set reviewed, currency-specific limits before Ghana cash-out/exchange.
KORA_GHS_DAILY_LIMIT=0
KORA_GHS_MONTHLY_LIMIT=0
KORA_GHS_PAYOUT_FEE_BUFFER=0
# Exact HTTPS authorization hosts approved for your Kora merchant; comma separated.
KORA_REDIRECT_HOSTS=
